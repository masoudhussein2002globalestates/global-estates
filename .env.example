# Copy to .env — NEVER commit real values, NEVER reference these in frontend code
DATABASE_URL=postgres://user:password@localhost:5432/global_estates
STRIPE_SECRET_KEY=sk_test_xxx            # leave blank to run without payments
STRIPE_WEBHOOK_SECRET=whsec_xxx
JWT_SECRET=change-this-to-a-long-random-string
APP_URL=http://localhost:3000
PLATFORM_FEE_PERCENT=5                   # fee for Rent bookings (Vacation/Outings fixed at 10%)
CURRENCY=kes
SEED_ON_BOOT=true                        # seeds demo data if DB is empty
